#
# mod-animus -- bots for a stock AzerothCore realm, played by models trained in Animus Forge: followers of
# your level and faction that keep up with you as they did in training; dungeon party fill with them; the play
# capture the forge trains on, with opt-in recordings; Prepare. The v1 class companion is not in this build.
#
[worldserver]

###################################################################################################
# GENERAL
#
#    Animus.Enable
#        Description: Enable the module. When disabled no follower can be summoned, existing ones
#                     are removed on the next update and no model is loaded.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Animus.Enable = 1

#
#    Animus.PartyFill.Enable
#        Description: A player entering a five-player dungeon (alone, or as its group's leader) gets
#                     its group filled to five with followers (".animus follow": bots of the
#                     player's level and faction played by the follow models), two seconds after
#                     arriving. They are temporary: never saved, and gone when the player leaves the
#                     dungeon alive (a released ghost running back in keeps them). Each follower
#                     renders a camera every decision: four of them cost what four followers cost.
#                     Each player can switch their own fill off (the addon's Settings tab,
#                     ".animus partyfill off"; saved per character in animus_player_settings), and a
#                     game master can switch the realm's off until the next ".reload config"
#                     (".animus partyfill realm off"), for a dungeon run recorded solo.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Animus.PartyFill.Enable = 1

#
#    Animus.Prepare.Security
#        Description: The account security the addon's Prepare needs (Settings tab, ".animus
#                     prepare <level> <spec>"): the character set to the level typed in, geared,
#                     talented and taught for a spec the way a companion is built, everything it
#                     wore and carried mailed back to it first. For getting a recording character
#                     ready in a minute. 0 player, 1 moderator, 2 game master, 3 administrator.
#        Default:     2 - (Game master)

Animus.Prepare.Security = 2

#
#    Animus.Prepare.BagItem
#        Description: The bag Prepare puts in each empty bag slot afterwards (the gear builder
#                     clears them; the old bags are in the mail). 0 for none.
#        Default:     4500 - (Traveler's Backpack, 16 slots)

Animus.Prepare.BagItem = 4500


###################################################################################################
# MODELS
#
#    Animus.ModelDir
#        Description: Directory holding the exported class models (<class>_follow.amdl, each
#                     with its layout manifest <class>_follow.json beside it), written by the
#                     forge's export. A relative path is looked for under DataDir (worldserver.conf)
#                     first, for models placed by hand, then where the build installs the module's
#                     models/ with its configs: <config dir>/modules/animus (Docker: the image's
#                     env/ref/etc/modules/animus, then env/dist/etc/modules/animus). The startup
#                     log names the directory used. An absolute path is used as is.
#        Default:     "animus"

Animus.ModelDir = "animus"

#
#    Animus.Curriculum.Stage
#        Description: The curriculum stage whose models the followers play: its layout decides the
#                     observation and the actions, and its suffix the model names (<class>_follow).
#                     A name that is not a stage falls back to the default.
#        Default:     "move4_follow"

Animus.Curriculum.Stage = "move4_follow"

#
#    Animus.Curriculum.DecisionMs
#        Description: Game time between a follower's model decisions, in milliseconds: the
#                     decision interval its models were trained with (AnimusForge.DecisionMs).
#        Default:     250

Animus.Curriculum.DecisionMs = 250

###################################################################################################
# CAMERA AND MENTAL MAP
#
# The followers see through the forge's camera (a ray-cast third-person view), drawn from baked
# scenes of each map's static world. The settings must be the ones the models were trained with
# (stage.json blocks[vision] of the run; the defaults are move4_follow's): a different size or
# field of view is a different picture. Changing any of them needs a restart.
#
#    Animus.DataDir
#        Description: A writable directory for the module's own data: the baked camera scenes go in
#                     its scenes/ (made when missing). A relative path is under the config directory.
#        Default:     "" - <config dir>/modules/animus

Animus.DataDir = ""

#
#    Animus.Vision.Maps
#        Description: The maps whose camera scenes are baked (when missing or stale) and loaded at
#                     startup, comma separated. A follower can only be summoned on one of them; on any
#                     other map its camera sees an empty world. Baking a dungeon takes seconds to a
#                     minute, once; the startup log names each map's time.
#        Default:     "389,36,43,34" - Ragefire Chasm, the Deadmines, Wailing Caverns, the Stockade

Animus.Vision.Maps = "389,36,43,34"

#
#    Animus.Vision.RenderSizes
#        Description: The render sizes the models were trained with, "WxH, WxH:weight, ..." (the forge's
#                     AnimusForge.Vision.RenderSizes). A model's layout manifest records them, so this must be
#                     the training run's list or every model is refused.
#        Default:     "32x16, 48x24, 64x32, 128x64:0.4"

Animus.Vision.RenderSizes = "32x16, 48x24, 64x32, 128x64:0.4"

#
#    Animus.Vision.RenderSize
#        Description: The one of those sizes, WxH, every follower's frames are cast at, scaled up to
#                     Width x Height. Smaller is cheaper on the world thread.
#        Default:     "64x32"

Animus.Vision.RenderSize = "64x32"

#
#    Animus.Vision.Width
#    Animus.Vision.Height
#        Description: The canonical image the model reads, in pixels (AnimusForge.Vision.Width/Height).
#        Default:     128, 64

Animus.Vision.Width = 128
Animus.Vision.Height = 64

#
#    Animus.Vision.FovH
#    Animus.Vision.FovV
#        Description: The camera's fields of view, degrees.
#        Default:     120, 60

Animus.Vision.FovH = 120
Animus.Vision.FovV = 60

#
#    Animus.Vision.Range
#        Description: How far, in yards, the camera sees units.
#        Default:     100

Animus.Vision.Range = 100

#
#    Animus.Vision.Zoom
#    Animus.Vision.ZoomMin
#        Description: Where the camera's boom starts (and recentres to), and the nearest its zoom-in
#                     reaches, yards. move4_follow trained with both locked at 12.
#        Default:     12, 12

Animus.Vision.Zoom = 12
Animus.Vision.ZoomMin = 12

#
#    Animus.Vision.Pitch
#        Description: The camera's starting pitch, degrees (+ up).
#        Default:     -15

Animus.Vision.Pitch = -15

#
#    Animus.Map.MaxTiles
#    Animus.Map.CoarseTiles
#        Description: The mental map's caps: fine tiles kept, and coarse tiles an evicted fine tile
#                     folds into (0: an evicted tile is forgotten, as in training).
#        Default:     4096, 0

Animus.Map.MaxTiles = 4096
Animus.Map.CoarseTiles = 0

#
#    Animus.Map.ClusterMinCells
#    Animus.Map.PocketMinCells
#        Description: The map block's coverage analysis (the forge's Seek.ClusterMinCells and
#                     Seek.PocketMinCells).
#        Default:     2, 6

Animus.Map.ClusterMinCells = 2
Animus.Map.PocketMinCells = 6

###################################################################################################
# FOLLOW TUNING
#
# The forge's AnimusForge.Curriculum.* keys a follower plays by, under this prefix; the defaults are
# move4_follow's. They change what the model may press, so they must match what it trained with.
#
#    Animus.Curriculum.Actions.RepeatMs
#    Animus.Curriculum.Actions.MoveRepeatMs
#    Animus.Curriculum.Actions.StopCastMinMs
#    Animus.Curriculum.Actions.RecastAfterStopMs
#    Animus.Curriculum.Actions.ModeLockMs
#        Description: Action pacing: the same action again, the same movement order again, the
#                     shortest cast it may stop, a stopped spell's lockout, a stance or form's lock.
#        Default:     1000, 300, 500, 2000, 5000

Animus.Curriculum.Actions.RepeatMs = 1000
Animus.Curriculum.Actions.MoveRepeatMs = 300
Animus.Curriculum.Actions.StopCastMinMs = 500
Animus.Curriculum.Actions.RecastAfterStopMs = 2000
Animus.Curriculum.Actions.ModeLockMs = 5000

#
#    Animus.Curriculum.Options.RestMaxMs
#    Animus.Curriculum.Options.HoldInterruptMs
#    Animus.Curriculum.Options.JitterDecayMs
#        Description: How long durative actions may run, and the movement jitter's decay.
#        Default:     30000, 10000, 2500

Animus.Curriculum.Options.RestMaxMs = 30000
Animus.Curriculum.Options.HoldInterruptMs = 10000
Animus.Curriculum.Options.JitterDecayMs = 2500

#
#    Animus.Curriculum.PartyFollow.MinimapYards
#        Description: The minimap's radius: party members within it show as dots.
#        Default:     60

Animus.Curriculum.PartyFollow.MinimapYards = 60

#
#    Animus.Curriculum.Respawn.DelayMs
#        Description: A follower that died stands up again this long after, beside its caller, at
#                     full health and power (training rises at the episode's start point).
#        Default:     10000

Animus.Curriculum.Respawn.DelayMs = 10000

#
#    Animus.Follow.EpisodeSeconds
#        Description: The synthetic episode the followers play in: it starts at the summon, and
#                     every this long it rolls over (a full reset with the mental map kept). The
#                     model's episode clock ramps from 0 to 1 over 300 s whatever this is (training's
#                     episodes were 300 s). A new map or instance starts a new episode with the
#                     mental map cleared.
#        Default:     300

Animus.Follow.EpisodeSeconds = 300

#
#    Animus.Follow.Security
#        Description: The account security ".animus follow" and the addon's Summon need. 0 player,
#                     1 moderator, 2 game master, 3 administrator. Party fill does not need it.
#        Default:     0 - (Every player)

Animus.Follow.Security = 0

###################################################################################################
# PLAY CAPTURE
#
#    Two tiers, one writer and one file format (doc/capture-format.md, format 4; README, "Play
#    capture"):
#
#    The AUTOMATIC TIER records what every player on the realm does (movement packets, casts,
#    targets, outcomes, world snapshots) and what the companions decide, into hourly files, with
#    no opt-in; players are told at login (Animus.Capture.LoginNotice). No chat, names, account
#    data or IPs are written there: characters and units are hashed ids, salted with <Dir>/salt.
#
#    MANUAL RECORDINGS start only when a player presses Record (the addon's Record tab or bar,
#    ".animus record on") and end when they stop (keep or discard, a title): their own play, into
#    <Dir>/recordings/<id>/ at the Recording.* rates and detail -- 100 ms snapshots, every nearby
#    unit's state with auras and threat lists, object states, the map's spawn table, the raw
#    packets both ways, their group's chat, their typed notes. A recording is identified (the
#    character's name is in it) and the player is told so when it starts (Recording.Notice). While
#    they record, their records go to the recording only, not to the hourly files.
#
#    Animus.Capture.Enable
#        Description: The writer: capture of either tier to Animus.Capture.Dir. Can be switched on
#                     and off with ".reload config".
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Animus.Capture.Enable = 1

#
#    Animus.Capture.Auto
#        Description: The automatic tier: every player recorded from login into the hourly files.
#                     Off, nothing is written and nobody is told until someone presses Record.
#        Default:     1 - (Enabled)
#                     0 - (Disabled: manual recordings only)

Animus.Capture.Auto = 1

#
#    Animus.Capture.Dir
#        Description: Where the files go: <Dir>/<yyyy-mm-dd>/<hh>/<stream>-<map>.bin.gz (UTC), an
#                     index.json per hour, <Dir>/recordings/<id>/ per manual recording with its
#                     manifest.json, and <Dir>/salt (made once, never replaced). Must be a writable
#                     directory with room to grow: nothing is ever deleted (under Docker, not the
#                     read-only data volume). Empty: <LogsDir>/animus-capture, the logs directory
#                     the realm already writes to (under Docker the logs bind mount,
#                     env/dist/logs/animus-capture on the host); the working directory when there
#                     is no LogsDir either. Read at startup only.
#        Default:     "" - (<LogsDir>/animus-capture)

Animus.Capture.Dir = ""

#
#    Animus.Capture.SnapshotMs
#    Animus.Capture.IdleSnapshotMs
#        Description: How often a player's world snapshot (self, nearby units, auras, cooldowns) is
#                     taken in the automatic tier, in milliseconds: SnapshotMs while in combat or
#                     moving, IdleSnapshotMs otherwise. Snapshots are most of the volume; the idle
#                     rate is the first lever if storage runs short. Movement is never thinned.
#        Default:     250, 1000

Animus.Capture.SnapshotMs = 250
Animus.Capture.IdleSnapshotMs = 1000

#
#    Animus.Capture.Streams
#        Description: Which streams are written, a sum of: 1 session, 2 move, 4 action,
#                     8 snapshot, 16 outcome, 32 companion, 64 note, 128 packet. The note and
#                     packet streams carry recordings only.
#        Default:     255 - (all)

Animus.Capture.Streams = 255

#
#    Animus.Capture.FlushMs
#        Description: How often buffered records are compressed and appended to their files, in
#                     milliseconds. A crash loses at most this much.
#        Default:     1000

Animus.Capture.FlushMs = 1000

#
#    Animus.Capture.BufferRecords
#        Description: Each producing thread's buffer (the world thread and every map thread), in
#                     128-byte record slots: a movement record takes one, a crowded snapshot up to
#                     about thirty, a recording's packet chunk up to 470. A full buffer drops
#                     records, never waits; drops are logged and counted in the hour's index.json
#                     or the recording's manifest. Read at startup only.
#        Default:     131072 - (16 MiB a thread)

Animus.Capture.BufferRecords = 131072

#
#    Animus.Capture.DiskWarnGB
#    Animus.Capture.DiskReserveGB
#        Description: Free space under Dir, checked every ten seconds. Below DiskWarnGB a warning is
#                     logged (every ten minutes); below DiskReserveGB the snapshot stream pauses
#                     (logged loudly, recorded in the hour's index.json), every open recording is
#                     stopped (end reason "disk"), and the stream resumes 1 GB above it. Movement
#                     and the other streams are never paused.
#        Default:     50, 10

Animus.Capture.DiskWarnGB = 50
Animus.Capture.DiskReserveGB = 10

#
#    Animus.Capture.LoginNotice
#        Description: Told to every player at login while the automatic tier is on. Empty: no
#                     notice.
#        Default:     "Play on this realm is recorded (movement, actions and combat; never chat or
#                     account details) to train its bots to play like people."

Animus.Capture.LoginNotice = "Play on this realm is recorded (movement, actions and combat; never chat or account details) to train its bots to play like people."

#
#    Animus.Capture.Recording.SnapshotMs
#    Animus.Capture.Recording.UnitMs
#        Description: A recording's rates, in milliseconds: the player's own snapshot (moving, in
#                     combat or idle alike), and each nearby unit's full state (UnitState: position,
#                     velocity, health, power, target, victim, cast, motion, home, auras, threat
#                     list).
#        Default:     100, 100

Animus.Capture.Recording.SnapshotMs = 100
Animus.Capture.Recording.UnitMs = 100

#
#    Animus.Capture.Recording.UnitRange
#    Animus.Capture.Recording.MaxUnits
#        Description: Which units a recording's UnitState covers: the nearest MaxUnits within
#                     UnitRange yards of the player (party members and the player's pet always).
#        Default:     80, 128

Animus.Capture.Recording.UnitRange = 80
Animus.Capture.Recording.MaxUnits = 128

#
#    Animus.Capture.Recording.Packets
#    Animus.Capture.Recording.PacketMaxBytes
#    Animus.Capture.Recording.PacketSkip
#        Description: The raw packets between the recording player's client and the server, both
#                     ways, as sent (the packet stream): on or off; the most bytes of one packet
#                     kept (a longer one is cut and flagged); and the opcodes left out, by name or
#                     number, space-separated. The chat opcodes are left out by default (their text
#                     is the Chat record's, redacted as the rules say) and Warden's; add
#                     SMSG_NAME_QUERY_RESPONSE to keep nearby players' names out of the recording.
#        Default:     1, 1048576,
#                     "SMSG_MESSAGECHAT SMSG_GM_MESSAGECHAT CMSG_MESSAGECHAT SMSG_WARDEN_DATA CMSG_WARDEN_DATA"

Animus.Capture.Recording.Packets = 1
Animus.Capture.Recording.PacketMaxBytes = 1048576
Animus.Capture.Recording.PacketSkip = "SMSG_MESSAGECHAT SMSG_GM_MESSAGECHAT CMSG_MESSAGECHAT SMSG_WARDEN_DATA CMSG_WARDEN_DATA"

#
#    Animus.Capture.Recording.OthersChat
#        Description: Whether a recording keeps the text of real players outside the recorder's
#                     group. Off, their lines are kept with the text redacted (length only); the
#                     recorder's own lines, their group's, companions', creatures' and the
#                     system's are always kept.
#        Default:     0 - (Redacted)
#                     1 - (Kept)

Animus.Capture.Recording.OthersChat = 0

#
#    Animus.Capture.Recording.MaxMinutes
#        Description: A recording stops by itself after this long (end reason "max minutes").
#        Default:     240

Animus.Capture.Recording.MaxMinutes = 240

#
#    Animus.Capture.Recording.Notice
#        Description: Told to the player when their recording starts. Empty: no notice.
#        Default:     "Your play and surroundings -- movement, actions, combat, your group's chat
#                     -- are saved to this realm's recordings until you stop."

Animus.Capture.Recording.Notice = "Your play and surroundings -- movement, actions, combat, your group's chat -- are saved to this realm's recordings until you stop."

#
#    Animus.Capture.Recording.GodSecurity
#        Description: The account security god mode from the addon needs (".animus god on|off"):
#                     the stock ".cheat god", switched off again when the recording that switched
#                     it on stops, and flagged in the recording (RecordingStart, PlayerDetail,
#                     every note, the manifest), since health and damage under it are no longer
#                     human-like. 0 player, 1 moderator, 2 game master, 3 administrator.
#        Default:     2 - (Game master)

Animus.Capture.Recording.GodSecurity = 2
