#
# mod-animus -- companions whose combat decisions come from a model trained in mod-animus-forge.
#
[worldserver]

###################################################################################################
# GENERAL
#
#    Animus.Enable
#        Description: Enable the module. When disabled no companions can be summoned, existing ones
#                     are removed on the next update and no model is loaded.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Animus.Enable = 1

###################################################################################################
# MODEL
#
#    Animus.ModelDir
#        Description: Directory holding the exported models (<scenario>.amdl, written by
#                     "python -m animus.export" in mod-animus-forge). A relative path is resolved
#                     against DataDir (worldserver.conf). The build installs the module's
#                     models/*.amdl to <install prefix>/data/animus; if DataDir points elsewhere,
#                     configure with -DANIMUS_MODELS_INSTALL_DIR=<DataDir>/animus or use an absolute
#                     path here. The model is reloaded on ".reload config"; a model that fails to
#                     load keeps the previous one in use.
#        Default:     "animus"

Animus.ModelDir = "animus"

#
#    Animus.DecisionMs
#        Description: Game time between model decisions, in milliseconds. Match the decision
#                     interval the model was trained with (mod-animus-forge: 50 ms per
#                     AnimusForge.DecisionTicks).
#        Default:     50

Animus.DecisionMs = 50

###################################################################################################
# CLASS/ROLE COMPANIONS
#
#    Animus.ClassRole.Stage
#        Description: Which curriculum stage's models class/role companions (".animus summon") play:
#                     <class>_<role>_<stage>.amdl in Animus.ModelDir, exported by mod-animus-forge with
#                     its layout manifest (<class>_<role>_<stage>.json) beside it. A model whose manifest
#                     differs from this server's layout is refused. Companions summoned before a
#                     ".reload config" keep the stage they were summoned with.
#        Default:     "party"  - four companions that play together (class_role_party)
#                     "companion", "gauntlet", "pack", "duel", "dummy", "pvp", "arena"
#                              - the models of that stage (class_role_<stage>)

Animus.ClassRole.Stage = "party"

#
#    Animus.ClassRole.EpisodeSeconds
#        Description: The episode length the models were trained with (AnimusForge.EpisodeSeconds). A
#                     companion sees how far into an episode it is; an episode starts with the first
#                     pull after 20 seconds without fighting, or once the last one has run this long.
#        Default:     300

Animus.ClassRole.EpisodeSeconds = 300

###################################################################################################
